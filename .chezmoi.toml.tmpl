{{- $isWorkComputer := promptBoolOnce . "isWorkComputer" "Is this your work computer" -}}

[data]
    isWorkComputer = {{ $isWorkComputer }}

[git]
    autoCommit = true

[diff]
    command = "code"
    args = ["--wait", "--diff"]

[edit]
    command = "code"
    args = ["--wait"]

[merge]
    command = "bash"
    args = [
        "-c",
        {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }}
    ]
