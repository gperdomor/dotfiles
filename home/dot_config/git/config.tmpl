[user]
	name = {{ .name }}
	email = {{ .emailAddress }}
	signingkey = key::{{ onepasswordRead "op://op3k53txtuxsdn3ajfejlejos4/6qhqdhycazx76eve2lltmvdd6i/public_key" "Y6TIYA2XHNHYJBR5E2BJXPSH4M" }} {{ onepasswordRead "op://op3k53txtuxsdn3ajfejlejos4/6qhqdhycazx76eve2lltmvdd6i/title" "Y6TIYA2XHNHYJBR5E2BJXPSH4M" }}

[protocol]
	version = 2

[init]
	defaultBranch = main
	defaultRefFormat = reftable

[core]
	editor = code --wait
	pager = delta
	sshCommand = ssh

[push]
	default = upstream
	autoSetupRemote = true

[pull]
	rebase = true
	# rebase = interactive

[submodule]
	recurse = true

[rebase]
	autosquash = true
	autoStash = true

[commit]
	gpgsign = true

[gpg]
	format = ssh
	program = {{ env "HOMEBREW_PREFIX" }}/bin/gpg

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedsignersfile = {{ env "HOME" }}/.ssh/allowed_signers

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3

[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://dev.azure.com"]
	useHttpPath = true

[ghq]
	root = ~/Developer

[url "git@github.com:"]
	insteadOf = https://github.com/

[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/

[includeIf "hasconfig:remote.*.url:git@github.com:organization-name/**"]
	path = ~/.gitconfig-emu
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/organization-name/**"]
	path = ~/.gitconfig-emu
[includeIf "gitdir:~/Developer/github.com/organization-name/"]
	path = ~/.gitconfig-emu
