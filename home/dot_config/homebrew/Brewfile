brew "k6" # Modern load testing tool, using Go and JavaScript
brew "krunkit" # A CLI tool to start Linux KVM or macOS Hypervisor framework virtual machines using the libkrun platform.
brew "mise" # Polyglot runtime manager (asdf rust clone)
brew "opencode-v2" # OpenCode V2 - the AI coding agent for the terminal
brew "podman" # Tool for managing OCI containers and pods
brew "supabase"  # Supabase CLI
